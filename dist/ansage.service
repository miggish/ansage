# ansage as a systemd service. dist/install.sh installs it together with the
# binary, user/group ansage and /etc/ansage (see the README: Installing).
# Operators in group `ansage` can use `ansage show`, `ansage announce`, ...
# (the control socket /run/ansage/ansage.sock is mode 0660).

[Unit]
Description=ansage BGP speaker (announces own prefixes)
After=network-online.target
Wants=network-online.target

[Service]
# ansage sends READY=1 once its sessions are started, RELOADING=1 / READY=1
# around a reload and STOPPING=1 on shutdown.
Type=notify-reload
ExecStart=/usr/local/bin/ansage --config /etc/ansage/ansage.toml
# Type=notify-reload sends SIGHUP itself (systemd >= 253). On older systemd
# use Type=notify and uncomment (waits for the result, fails on a bad config;
# dist/install.sh does both):
#ExecReload=/usr/local/bin/ansage --config /etc/ansage/ansage.toml reload
User=ansage
Group=ansage
RuntimeDirectory=ansage
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5s
# `ansage upgrade` ends the sessions so that neighbors with Graceful Restart
# keep our routes, then exits with 75: not a failure, but start ansage again
# (with the binary now at the ExecStart path). Neighbors keep our routes for
# restart_time (default 30 s), well beyond RestartSec.
SuccessExitStatus=75
RestartForceExitStatus=75
# Closing sessions sends a NOTIFICATION and waits up to 3 s per neighbor.
# With drain_time, ansage extends this timeout itself (EXTEND_TIMEOUT_USEC).
TimeoutStopSec=15s

# Only needed with `listen` on a port below 1024 (179). Without it, remove
# both lines: ansage needs no capabilities to connect out.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Only needed with [kernel] (ansage installs routes into the kernel's
# routing table): dist/install.sh uncomments these three lines when the
# config has a [kernel] section.
#AmbientCapabilities=CAP_NET_ADMIN
#CapabilityBoundingSet=CAP_NET_ADMIN
#RestrictAddressFamilies=AF_NETLINK

# Hardening: ansage needs TCP (IPv4/IPv6), its unix control socket and
# nothing else (netlink with [kernel], see above; the lists add up).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
